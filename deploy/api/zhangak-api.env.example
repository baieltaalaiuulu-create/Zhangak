NODE_ENV=production
HOST=127.0.0.1
PORT=3210
DATABASE_URL=postgresql://zhangak:replace-with-urlencoded-password@127.0.0.1:5433/zhangak
DATABASE_SSL=0
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ALLOWED_ORIGINS=https://zhangak.com,https://platform.zhangak.com,https://offline.zhangak.com,https://admin.zhangak.com
TRUST_PROXY=1
ZHANGAK_API_RELEASE_SHA=replace-with-git-sha
# Private mount owned by zhangak-api (mode 0750), never served by Nginx.
ZHANGAK_STORAGE_ROOT=/mnt/HC_Volume_106608581/zhangak-materials
# Web Push VAPID keys are server secrets. Generate once for the environment;
# never rotate them casually because existing browser subscriptions depend on them.
VAPID_SUBJECT=mailto:admin@zhangak.com
VAPID_PUBLIC_KEY=install-generated-public-key
VAPID_PRIVATE_KEY=install-generated-private-key-never-in-git
# Keep AI disabled until a newly rotated provider key is installed server-side.
AI_ENABLED=0
AI_PROVIDER=deepseek
# Optional service-continuity fallback. It is used only after a safe primary
# provider failure; rate-limit responses are never retried against it.
AI_FALLBACK_PROVIDER=
# DEEPSEEK_API_KEY=install-a-rotated-key-here-never-in-git
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_FAST_MAX_TOKENS=900
# OPENAI_API_KEY=install-a-rotated-key-here-never-in-git
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_FAST_MAX_TOKENS=700
