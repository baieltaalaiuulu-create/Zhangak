# Install as /etc/zhangak/zhangak.env with owner root:zhangak and mode 0640.
# Never commit the populated file.
HOSTNAME=127.0.0.1
PORT=3200
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
PRACTICE_TRUSTED_SUBMISSION_ENABLED=0
AI_PROVIDER=groq
GROQ_API_KEY=replace-me
