[Unit]
Description=Zhangak Next.js application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zhangak
Group=zhangak
WorkingDirectory=/var/www/zhangak/current
EnvironmentFile=/etc/zhangak/zhangak.env
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/test -r server.js
ExecStartPre=/usr/bin/test -r release.json
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
