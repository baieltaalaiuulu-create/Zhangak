[Unit]
Description=Create a verified Zhangak PostgreSQL logical backup
Documentation=file:///usr/local/share/doc/zhangak/backup/README.md
Requires=docker.service
After=docker.service mnt-HC_Volume_106608581.mount
ConditionPathIsMountPoint=/mnt/HC_Volume_106608581

[Service]
Type=oneshot
EnvironmentFile=-/etc/zhangak-backup.env
ExecStart=/usr/local/sbin/zhangak-postgres-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/mnt/HC_Volume_106608581
