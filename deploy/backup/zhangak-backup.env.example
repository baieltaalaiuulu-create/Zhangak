# This file belongs on the VPS at /etc/zhangak-backup.env (root:root, mode 0600).
# It contains no password: pg_dump runs inside the already configured local container.

ZHANGAK_BACKUP_ROOT=/mnt/HC_Volume_106608581/zhangak-backups
ZHANGAK_POSTGRES_CONTAINER=zhangak-postgres
ZHANGAK_POSTGRES_USER=zhangak
ZHANGAK_POSTGRES_DATABASE=zhangak
ZHANGAK_BACKUP_RETENTION_DAYS=14
