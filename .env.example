# Copy to .env.local for local development. In production (Vercel), set
# these under Project Settings → Environment Variables instead.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — used by the admin API routes (create/delete users, reset
# passwords, etc). Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Keep disabled until the reviewed begin_practice_attempt_v2 and
# submit_practice_attempt_v2 database functions are deployed and tested.
PRACTICE_TRUSTED_SUBMISSION_ENABLED=0

# ── AI Gateway (lib/ai-gateway.ts) ───────────────────────────────────────
# Which provider is active. Defaults to 'groq' if unset.
# One of: deepseek | groq | gemini | openai | ollama
AI_PROVIDER=groq

# Recommended production provider. Ordinary mentor questions use V4 Flash
# without thinking; analysis and plan requests use V4 Pro with thinking.
# Keep this key server-only. Never prefix it with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MAX_TOKENS=1200
DEEPSEEK_REASONING_MAX_TOKENS=2400

# Required for the default provider (groq). Get a key at https://console.groq.com
# IMPORTANT: this must be added to the project's environment variables in
# Vercel (Project Settings → Environment Variables) for AI Mentor / AI
# Анализ / analytics insights to work in production — it is not set
# automatically.
GROQ_API_KEY=

# Optional — only needed if AI_PROVIDER is switched to one of these:
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
