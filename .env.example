# Copy to .env.local for local development. In production (Vercel), set
# these under Project Settings → Environment Variables instead.

# ── First-party API ───────────────────────────────────────────────────────
# The Next.js BFF proxies only to the local Zhangak API service. Leave this
# unset in the standard local setup to use the secure default below.
ZHANGAK_API_INTERNAL_URL=http://127.0.0.1:3210
