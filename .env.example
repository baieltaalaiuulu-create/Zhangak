# Copy to .env.local for local development. In production (Vercel), set
# these under Project Settings → Environment Variables instead.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — used by the admin API routes (create/delete users, reset
# passwords, etc). Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Gateway (lib/ai-gateway.ts) ───────────────────────────────────────
# Which provider is active. Defaults to 'groq' if unset.
# One of: groq | gemini | openai | ollama
AI_PROVIDER=groq

# Required for the default provider (groq). Get a key at https://console.groq.com
# IMPORTANT: this must be added to the project's environment variables in
# Vercel (Project Settings → Environment Variables) for AI Mentor / AI
# Анализ / analytics insights to work in production — it is not set
# automatically.
GROQ_API_KEY=

# Optional — only needed if AI_PROVIDER is switched to one of these:
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
