# Same Supabase project as the web app (olqikkvjeutdgewmhnub).
# EXPO_PUBLIC_ vars are inlined into the client bundle by Metro — this is
# the anon/publishable key, safe to expose (RLS enforces access control),
# same as NEXT_PUBLIC_SUPABASE_ANON_KEY in the web app's .env.local.
EXPO_PUBLIC_SUPABASE_URL=https://olqikkvjeutdgewmhnub.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
